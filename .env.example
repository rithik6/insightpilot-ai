# Supported values are development, test, staging, and production.
INSIGHTPILOT_ENVIRONMENT=development
INSIGHTPILOT_LOG_LEVEL=INFO
INSIGHTPILOT_SESSION_LIFETIME_DAYS=90
# Set exact origins as a JSON array for HTTPS or a nondefault local port.
INSIGHTPILOT_ALLOWED_ORIGINS=[]

# Set a local password in .env before starting Docker Compose.
INSIGHTPILOT_POSTGRES_PASSWORD=
INSIGHTPILOT_API_PORT=8000
